# MongoDB Atlas connection string (sandbox/dev cluster for local + staging)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/oodelscore

# Auth (Milestone 2)
JWT_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Oodel Score <noreply@oodelscore.com>
APP_URL=http://localhost:3000

# Set to "true" to (re)seed platform-wide defaults (system roles, email
# templates, CX Pulse framework) on every app boot. Must run at least once
# before SEED_DEMO will work — the demo seed depends on the "Admin" role.
SEED_BASE=

# Set to "true" to (re)seed the 4 demo login accounts on every app boot.
# Same idempotency/turn-it-back-off notes as SEED_BASE above.
SEED_DEMO=

# Stripe (Milestone 4) — always test-mode keys until the full app is
# verified end-to-end (see CLAUDE.md).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=

# Populated in a later milestone:
# ANTHROPIC_API_KEY=
