# Copy to .env and fill in for local development. Export these into your
# shell (or use `node --env-file=.env`) before running `npm run seed` or the
# worker — Render injects the equivalent env vars directly in deployed
# environments.

# MongoDB Atlas connection string (sandbox/dev cluster)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/oodelscore

# Auth (Milestone 2)
# Secret used to sign session JWTs — use a long random string, different per
# environment. Rotating it invalidates every issued session.
JWT_SECRET=

# Resend (used for the invite/password-reset emails in Section 11's trigger
# table). Sending is entirely optional for local dev — the demo seed script
# does not use it.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Oodel Score <noreply@oodelscore.com>

# Base URL used to build set-password links in invite/reset emails.
APP_URL=http://localhost:3000

# Set to "true" to (re)seed the platform-wide defaults (system roles, email
# templates, CX Pulse framework) on every app boot (apps/web/instrumentation.ts).
# Must be seeded at least once before SEED_DEMO will work — the demo seed
# depends on the "Admin" role existing. Idempotent — safe to leave on, but
# turn it back off once seeded to avoid unnecessary writes on every restart.
SEED_BASE=

# Set to "true" to (re)seed the 4 demo login accounts on every app boot.
# Same idempotency/turn-it-back-off notes as SEED_BASE above.
SEED_DEMO=

# Stripe (Milestone 4) — always a sk_test_/whsec_test_ key until the full
# app is verified end-to-end (see CLAUDE.md).
STRIPE_SECRET_KEY=

# Only exists once you've registered the webhook endpoint in the Stripe
# Dashboard (Developers -> Webhooks) after this is deployed — see the
# Milestone 4 PR description for the exact steps and event list.
STRIPE_WEBHOOK_SECRET=

# Price IDs for the two paid plans. Run `npm run setup:stripe-prices` (needs
# STRIPE_SECRET_KEY set) to create them and print these two values.
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=

# Populated in a later milestone:
# ANTHROPIC_API_KEY=
